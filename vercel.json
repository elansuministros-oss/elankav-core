{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/api/whatsapp",
      "destination": "/api/whatsapp-v2"
    },
    {
      "source": "/api/whatsapp-media",
      "destination": "/api/whatsapp-v2?mediaProxy=1"
    }
  ]
}
